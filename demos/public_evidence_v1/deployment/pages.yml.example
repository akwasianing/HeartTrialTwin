# INERT EXAMPLE: not under .github/workflows; do not activate without approval.
name: Public evidence replay (manual, approved deployment only)
'on':
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: public-evidence-pages
  cancel-in-progress: false
jobs:
  deploy:
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - uses: actions/checkout@v6
      - run: python3 -I -B demos/public_evidence_v1/build_site.py --check
      - uses: actions/configure-pages@v5
      - uses: actions/upload-pages-artifact@v4
        with:
          path: demos/public_evidence_v1/site
      - name: Deploy approved static artifact
        id: deployment
        uses: actions/deploy-pages@v4
